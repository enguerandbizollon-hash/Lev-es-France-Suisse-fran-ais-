# Copiez ce fichier en ".env" et renseignez vos valeurs.
# NE COMMITTEZ JAMAIS le fichier .env réel (il est ignoré par git).

# --- Mode recommandé : compte de service (automatisation, sans humain) ---
# Chemin vers le fichier JSON du compte de service téléchargé depuis Google Cloud.
GOOGLE_SERVICE_ACCOUNT_FILE=./service_account.json

# Alternative : coller directement le JSON (utile en CI / variables d'environnement).
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}

# --- Mode alternatif : OAuth utilisateur (usage interactif sur poste) ---
# GOOGLE_OAUTH_CLIENT_FILE=./client_secret.json
# GOOGLE_OAUTH_TOKEN_FILE=./token.json
