# Variables d'environnement du connecteur hébergé.
# À configurer dans Vercel (Settings → Environment Variables) — JAMAIS committées.

# Identifiants du client OAuth « Application de bureau » (Google Cloud).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Jeton de rafraîchissement du robot Scale Up (obtenu via `npm run get-token`).
# Le compte autorisé ne doit voir QUE le Drive partagé Scale Up — jamais de données privées.
GOOGLE_REFRESH_TOKEN=
